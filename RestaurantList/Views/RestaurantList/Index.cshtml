@model List<RestaurantList.Models.Restaurant>
@{
    ViewData["Title"] = "RestaurantIndex";
}

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-6">
                <div>
                    <h4>@item.Name</h4>
                </div>
                <div>
                    @item.ImageUrl
                </div>
                <div>
                    @item.Address
                </div>
            </div>
        }
    </div>
</div>
